# Copy to .env and fill the blanks. Never commit .env.
# Claude itself runs on your Pro login — there is NO Anthropic API key here.

# --- Figma ---
FIGMA_TOKEN=            # figma.com > Settings > Personal access tokens (for local MCP; remote uses OAuth)

# --- Airtable (dashboard) ---
AIRTABLE_TOKEN=         # airtable.com > Builder hub > Personal access tokens
AIRTABLE_BASE_ID=       # the base you duplicated

# --- Asana (tasks) ---
ASANA_TOKEN=            # asana.com > Settings > Apps > Personal access token
ASANA_PROJECT_ID=

# --- GitHub (hosting + verify) ---
GITHUB_TOKEN=           # read-only PAT, used to confirm a commit resolves
