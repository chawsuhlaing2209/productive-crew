{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(git *)",
      "Bash(node scripts/*)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|mcp__airtable.*|mcp__asana.*",
        "hooks": [
          {
            "type": "command",
            "command": "test -f AGENTS_PAUSED && { echo 'AGENTS_PAUSED is set — fleet halted. Delete the file to resume.' >&2; exit 2; } || exit 0"
          }
        ]
      }
    ]
  }
}
